{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "homecoreos",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "keep_vars": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FIRMWARE_BUCKET",
      "bucket_name": "homecoreos-firmware"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
