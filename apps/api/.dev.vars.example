# ============================================================================
# OPTIONAL standalone Worker (MQTT-over-WSS Durable Object bridge) only.
# The normal deployment is Cloudflare Pages Functions and needs NO .dev.vars:
# add DB + FIRMWARE_BUCKET bindings and SECRETS_KEY in the Cloudflare dashboard.
#
# Safe placeholders only. Never commit real values.
# ============================================================================

# One-time bootstrap secret: 64 hex chars (openssl rand -hex 32).
# In production this is an encrypted Cloudflare Pages variable, never a file.
SECRETS_KEY=replace-with-64-character-hex-random-key

# Local-only overrides (dev never needs these; generated automatically).
# JWT_SECRET=replace-with-a-long-random-local-dev-secret
# INGRESS_HMAC_SECRET=replace-with-a-long-random-local-dev-secret
# PUBLIC_API_BASE=http://127.0.0.1:8787

# Only when testing the Supabase provider locally. These two are the sole
# bootstrap values; all other Supabase fields belong in the Owner Console.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# EMQX / MQTT credentials are NOT environment variables. Enter them in
# Owner Console -> Platform Settings -> Integrations & Secrets, where they are
# AES-256-GCM encrypted in platform_secrets.
