# Copy to /etc/homecoreos/bridge.env and fill in. Never commit the real file.
# Broker: bare hostname and TLS port, no mqtts:// prefix in MQTT_URL's host part.
MQTT_URL=mqtts://ybe9ef4c.ala.asia-southeast1.emqxsl.com:8883
# The bridge's own EMQX account: subscribe-only on v1/tenants/+/devices/+/+.
BRIDGE_MQTT_USERNAME=hc-bridge
BRIDGE_MQTT_PASSWORD=
# The public site that serves /internal/* (the Pages deployment).
HOMECOREOS_API=https://homecoreos.example.com
# Derived, not the raw service key: node scripts/bridge/derive_signing_key.mjs
SIGNING_KEY=
# Optional: PEM of the broker's CA, only if it is not trusted by default.
# MQTT_CA_FILE=/etc/homecoreos/broker-ca.pem
