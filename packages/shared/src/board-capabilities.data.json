      },
      "radio": {
        "wifi": true,
        "mqtt": true,
        "espnow": true,
        "espnow_protocol": "esp-now-v1",
        "espnow_mtu_bytes": 250,
        "espnow_peer_limit": 16,
        "espnow_encrypted_peer_limit": 8,
        "ble_provisioning": true,
        "softap_provisioning": true,
        "usb_recovery": true
      },
      "memory": {
        "flash_mb": 16,
        "psram_mb": 8,
        "psram_mode": "octal",
        "nominal_sram_kb": 512
      },
      "limits": {
        "max_controller_nodes": 10,
        "max_tested_controller_nodes": 0,
        "mqtt_buffer_bytes": 4096,
        "connectivity_queue_depth": 16,
        "telemetry_interval_sec": 30,
        "keepalive_ms": 2000,
        "link_timeout_ms": 10000,
        "recovery_window_ms": 45000,
        "discovery_interval_ms": 15000,
        "connectivity_task_stack_bytes": 6144
