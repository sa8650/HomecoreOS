# ============================================================================
# Helios — safe placeholders only. Copy to .env.local for local development.
# Never commit real credentials, tokens or secrets.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
DB_DRIVER=pglite                       # pglite (local) | supabase (production)
PORT=8787
JWT_SECRET=replace-with-a-long-random-local-dev-secret
INGRESS_HMAC_SECRET=replace-with-a-long-random-local-dev-secret
SECRETS_KEY=replace-with-64-character-hex-random-key

# --- Supabase (production / Workers) ---------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# --- EMQX Cloud Serverless -------------------------------------------------
MQTT_PROVIDER=emqx                     # emqx | local
EMQX_API_BASE=https://your-deployment.example:443/api/v5
EMQX_APP_ID=replace-with-application-id
EMQX_APP_SECRET=replace-with-application-secret
EMQX_BROKER_HOST=your-deployment.example
EMQX_TLS_PORT=8883
EMQX_WSS_URL=wss://your-deployment.example:8084/mqtt
EMQX_WSS_PORT=8084

# --- Platform MQTT ingress bridge (server-side only) -----------------------
MQTT_BRIDGE_URL=mqtt://127.0.0.1:1883
MQTT_BRIDGE_USERNAME=replace-with-dedicated-bridge-user
MQTT_BRIDGE_PASSWORD=replace-with-dedicated-bridge-password
MQTT_BROKER_ADMIN_URL=http://127.0.0.1:1884

# --- Cloudflare R2 (production) --------------------------------------------
R2_BUCKET=helios-firmware
PUBLIC_API_BASE=https://api.example.com

# --- Frontend (Cloudflare Pages, VITE_ vars are public by design) -----------
VITE_API_BASE=https://api.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Local development bootstrap only (never used in production) -----------
PLATFORM_OWNER_EMAIL=owner@helios.local
PLATFORM_OWNER_PASSWORD=replace-with-local-dev-password
