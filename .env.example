# HomecoreOS configuration reference.
# Add the values below in Cloudflare Pages → your project → Settings →
# Variables and Secrets. Do NOT put real values in this file or in GitHub.
# Keys and passwords must be added as encrypted "Secrets", never as plain text.

# Supabase (Project Settings → API Keys / Connect dialog)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EMQX Cloud Serverless (Deployment Overview → Deployment API Key / connection info)
EMQX_API_BASE=
EMQX_APP_ID=
EMQX_APP_SECRET=
EMQX_BROKER_HOST=
EMQX_TLS_PORT=8883

# Cloudflare Pages build (plain variable, not a secret)
NODE_VERSION=20

# ---------------------------------------------------------------------------
# Firmware storage is NOT configured here.
#
# In Cloudflare Pages → your project → Settings → Functions →
# "R2 bucket bindings", add a binding with the variable name:
#
#     FIRMWARE_BUCKET   ->  your private R2 bucket (Production environment)
#
# R2_BUCKET is accepted as an alias for the variable name.
# No R2 API token, access key, secret key, account ID, S3 endpoint or
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ENDPOINT
# variable is used. If you previously added any of those, delete them.
# The bucket stays private; the binding is server-side only.
# ---------------------------------------------------------------------------

# No authentication-provider keys, anon key, JWT secret or SECRETS_KEY.
# Accounts, password hashes, sessions and permissions live in Supabase PostgreSQL.
# No D1 database binding, KV namespace or other native binding is used.
