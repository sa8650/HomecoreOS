# HomecoreOS configuration reference.
# Add these in Cloudflare Pages → your project → Settings → Variables and Secrets.
# Do NOT put real values in this file or anywhere in GitHub.
# Keys and passwords must be added as encrypted "Secrets", never as plain text.

# Supabase (Project Settings → API Keys / Connect dialog)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EMQX Cloud Serverless (Deployment Overview → Deployment API Key / connection info)
EMQX_API_BASE=
EMQX_APP_ID=
EMQX_APP_SECRET=
EMQX_BROKER_HOST=
EMQX_TLS_PORT=8883

# Cloudflare Pages build (plain variable, not a secret)
NODE_VERSION=20

# No authentication-provider keys, anon key, JWT secret or SECRETS_KEY.
# Accounts, password hashes, sessions and permissions live in Supabase PostgreSQL.
# No D1 or R2 binding and no additional Cloudflare secret is required.
