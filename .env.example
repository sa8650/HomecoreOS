# ============================================================================
# HomecoreOS — safe placeholders only. NEVER put real credentials here.
#
# Production configuration is NOT done with this file:
#   Cloudflare Dashboard -> Workers & Pages -> Pages project -> Settings
#     Bindings            -> D1 database named DB
#                         -> R2 bucket named FIRMWARE_BUCKET
#     Variables and Secrets -> encrypted SECRETS_KEY (64 hex chars)
#     Save and redeploy.
#   Then Owner Console -> Initial Setup / Integrations & Secrets.
#
# This file is only for LOCAL DEVELOPMENT overrides. Copy to .env.local.
# ============================================================================

# --- Local runtime ---------------------------------------------------------
# pglite (real Postgres/WASM, default) | d1 (Cloudflare D1 emulator) | supabase
DB_DRIVER=pglite
PORT=8787

# One-time bootstrap secret. Local dev generates one automatically and keeps it
# in .local-dev/secrets-key (gitignored). In production set it ONLY in
# Cloudflare Pages -> Settings -> Variables and Secrets as an encrypted secret.
# Generate with: openssl rand -hex 32
SECRETS_KEY=replace-with-64-character-hex-random-key

# Optional local-only overrides. In production these fall back to SECRETS_KEY
# or the request origin, or are entered in the Owner Console encrypted.
# JWT_SECRET=replace-with-a-long-random-local-dev-secret
# INGRESS_HMAC_SECRET=replace-with-a-long-random-local-dev-secret
# PUBLIC_API_BASE=http://127.0.0.1:8787

# --- Supabase bootstrap (only when DB_DRIVER=supabase) ----------------------
# These two are the ONLY Supabase values required in Cloudflare server-side
# Variables and Secrets. Do not set them when using Cloudflare D1.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# All other Supabase fields (anon key, JWT secret) belong in the Owner Console
# under Integrations & Secrets and are encrypted at rest.

# --- EMQX / MQTT (Owner Console, encrypted at rest — NOT env vars) ----------
# EMQX_API_BASE, EMQX_APP_ID, EMQX_APP_SECRET, EMQX_BROKER_HOST, EMQX_TLS_PORT,
# EMQX_WSS_URL, MQTT_BRIDGE_USERNAME, MQTT_BRIDGE_PASSWORD are entered in
# Owner Console -> Platform Settings -> Integrations & Secrets.
# Do not duplicate them here.
MQTT_PROVIDER=local
MQTT_BRIDGE_URL=mqtt://127.0.0.1:1883
MQTT_BROKER_ADMIN_URL=http://127.0.0.1:1884

# --- Local development bootstrap only (never used in production) -----------
PLATFORM_OWNER_EMAIL=owner@homecoreos.local
PLATFORM_OWNER_PASSWORD=replace-with-local-dev-password

# --- Frontend ---------------------------------------------------------------
# The web app calls same-origin /api paths. No VITE_ secrets are needed for the
# D1 path, and no service-role key, MQTT password or admin secret may ever be
# exposed to a browser.
