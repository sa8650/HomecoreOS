# ESP32-S3-DevKitC-1 N16R8 (16MB QIO Flash + 8MB Octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_16mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_HOMECORE_BOARD_SLUG="esp32-s3-devkitc-1-n16r8"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_16mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=16
CONFIG_HOMECORE_PSRAM_SIZE_MB=8
