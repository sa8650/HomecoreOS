# ESP32-H2-DevKitM-1 (4MB DIO Flash, IEEE 802.15.4 + BLE 5.3 only - No Integrated Wi-Fi, BOOT=GPIO9)
CONFIG_IDF_TARGET="esp32h2"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_64M=y

CONFIG_HOMECORE_BOARD_SLUG="esp32-h2-devkitm-1"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_4mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=9
CONFIG_HOMECORE_FLASH_SIZE_MB=4
CONFIG_HOMECORE_PSRAM_SIZE_MB=0
