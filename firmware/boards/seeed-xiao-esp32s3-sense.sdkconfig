# Seeed Studio XIAO ESP32-S3 Sense (8MB QIO Flash + 8MB Octal PSRAM + Native USB-C)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_HOMECORE_BOARD_SLUG="seeed-xiao-esp32s3-sense"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_8mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=8
CONFIG_HOMECORE_PSRAM_SIZE_MB=8

CONFIG_HOMECORE_I2C_DEFAULT_SDA_GPIO=5
CONFIG_HOMECORE_I2C_DEFAULT_SCL_GPIO=6
CONFIG_HOMECORE_DRIVER_DHT22=y
CONFIG_HOMECORE_DRIVER_DS18B20=y
CONFIG_HOMECORE_DRIVER_BME280=y
CONFIG_HOMECORE_DRIVER_PIR=y
CONFIG_HOMECORE_DRIVER_REED=y
CONFIG_HOMECORE_DRIVER_BH1750=y
CONFIG_HOMECORE_DRIVER_ADC_VOLTAGE=y
CONFIG_HOMECORE_DRIVER_DHT11=y
CONFIG_HOMECORE_DRIVER_SHT3X=y
CONFIG_HOMECORE_DRIVER_AHT20=y
CONFIG_HOMECORE_DRIVER_TMP117=y
CONFIG_HOMECORE_DRIVER_VEML7700=y
CONFIG_HOMECORE_DRIVER_SGP30=y
CONFIG_HOMECORE_DRIVER_WATER_LEAK=y
CONFIG_HOMECORE_DRIVER_WATER_LEVEL=y
CONFIG_HOMECORE_DRIVER_SOIL_MOISTURE=y
CONFIG_HOMECORE_DRIVER_RAIN=y
CONFIG_HOMECORE_DRIVER_INA219=y
CONFIG_HOMECORE_DRIVER_INA226=y
CONFIG_HOMECORE_DRIVER_MQ2=y
CONFIG_HOMECORE_DRIVER_MQ135=y
CONFIG_HOMECORE_DRIVER_LD2410=y
