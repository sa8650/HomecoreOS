# ESP32-C6-DevKitC-1 (8MB DIO Flash, Wi-Fi 6 + BLE 5.3 + 802.15.4, BOOT=GPIO9)
CONFIG_IDF_TARGET="esp32c6"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_HOMECORE_BOARD_SLUG="esp32-c6-devkitc-1"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_8mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=9
CONFIG_HOMECORE_FLASH_SIZE_MB=8
CONFIG_HOMECORE_PSRAM_SIZE_MB=0
