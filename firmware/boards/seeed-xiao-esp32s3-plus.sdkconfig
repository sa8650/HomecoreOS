# Seeed Studio XIAO ESP32-S3 Plus (16MB QIO Flash + 8MB Octal PSRAM + Native USB-C)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_16mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_HOMECORE_BOARD_SLUG="seeed-xiao-esp32s3-plus"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_16mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=16
CONFIG_HOMECORE_PSRAM_SIZE_MB=8

CONFIG_HOMECORE_I2C_DEFAULT_SDA_GPIO=5
CONFIG_HOMECORE_I2C_DEFAULT_SCL_GPIO=6
CONFIG_HOMECORE_DRIVER_DHT22=y
CONFIG_HOMECORE_DRIVER_DS18B20=y
CONFIG_HOMECORE_DRIVER_BME280=y
CONFIG_HOMECORE_DRIVER_PIR=y
CONFIG_HOMECORE_DRIVER_REED=y
CONFIG_HOMECORE_DRIVER_BH1750=y
CONFIG_HOMECORE_DRIVER_ADC_VOLTAGE=y
