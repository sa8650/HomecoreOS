# Waveshare ESP32-S3-Zero (4MB QIO Flash + 2MB Quad PSRAM, Native USB-C, BOOT=GPIO0)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_HOMECORE_BOARD_SLUG="waveshare-esp32-s3-zero"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_4mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=4
CONFIG_HOMECORE_PSRAM_SIZE_MB=2

CONFIG_HOMECORE_I2C_DEFAULT_SDA_GPIO=8
CONFIG_HOMECORE_I2C_DEFAULT_SCL_GPIO=7
CONFIG_HOMECORE_DRIVER_DHT22=y
CONFIG_HOMECORE_DRIVER_DS18B20=y
CONFIG_HOMECORE_DRIVER_BME280=y
CONFIG_HOMECORE_DRIVER_PIR=y
CONFIG_HOMECORE_DRIVER_REED=y
CONFIG_HOMECORE_DRIVER_BH1750=y
CONFIG_HOMECORE_DRIVER_ADC_VOLTAGE=y
