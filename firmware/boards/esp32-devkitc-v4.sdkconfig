# ESP32-DevKitC V4 (4MB DIO Flash, Classic ESP32-WROOM-32E, BOOT=GPIO0)
CONFIG_IDF_TARGET="esp32"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

CONFIG_HOMECORE_BOARD_SLUG="esp32-devkitc-v4"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_4mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=4
CONFIG_HOMECORE_PSRAM_SIZE_MB=0
