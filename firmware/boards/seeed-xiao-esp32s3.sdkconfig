# Seeed Studio XIAO ESP32-S3 (8MB QIO Flash + 8MB Octal PSRAM + Native USB-C)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# XIAO ESP32-S3 routes console over native USB Serial/JTAG (GPIO43/44 are free D6/D7 pins)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_HOMECORE_BOARD_SLUG="seeed-xiao-esp32s3"
CONFIG_HOMECORE_PARTITION_SCHEME="dual_ota_8mb"
CONFIG_HOMECORE_BOOT_BUTTON_GPIO=0
CONFIG_HOMECORE_FLASH_SIZE_MB=8
CONFIG_HOMECORE_PSRAM_SIZE_MB=8
